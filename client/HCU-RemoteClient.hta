<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><title>کلاینت ریموت دانشگاه</title><hta:application applicationname="HCU Remote Client" border="thin" caption="yes" maximizebutton="no" minimizebutton="yes" showintaskbar="yes" singleinstance="yes" sysmenu="yes" scroll="no" windowstate="normal"/><style>
*{box-sizing:border-box}body{margin:0;background:#f2f6f9;color:#1c2e40;font:14px Tahoma,Arial}.top{background:#07559b;color:white;padding:18px 22px;border-bottom:5px solid #00a5a5}.top h1{font-size:18px;margin:0 0 5px}.wrap{padding:18px}.box{background:white;border:1px solid #dce6ee;border-radius:11px;padding:16px;margin-bottom:13px}h2{font-size:16px;color:#07559b;margin:0 0 10px}label{display:block;margin:9px 0 4px;font-weight:bold}input{width:100%;padding:9px;border:1px solid #cdd9e3;border-radius:7px;font:14px Tahoma}button{padding:9px 14px;border:0;border-radius:7px;background:#07559b;color:white;font:bold 13px Tahoma;cursor:pointer;margin:9px 4px 0 0}.alt{background:#167352}.del{background:#9d3931}.msg{margin-top:9px;min-height:22px;color:#9d302a}.ok{color:#167352}.fav{display:flex;justify-content:space-between;align-items:center;padding:7px;border-bottom:1px solid #e5edf3}.fav button{margin:0}.muted{font-size:11px;color:#687786}
</style><script language="javascript">
var root='https://172.16.2.99:8765',token='',eventId=0,sh=new ActiveXObject('WScript.Shell'),fs=new ActiveXObject('Scripting.FileSystemObject');
function el(i){return document.getElementById(i)}function msg(i,t,ok){el(i).innerText=t;el(i).className=ok?'msg ok':'msg'}
function call(method,path,data){var x=new ActiveXObject('WinHttp.WinHttpRequest.5.1');x.Open(method,root+path,false);x.Option(4)=13056;x.SetRequestHeader('Content-Type','application/json');if(token)x.SetRequestHeader('Authorization','Bearer '+token);x.Send(data?JSON.stringify(data):'');if(x.Status<200||x.Status>=300){var m='خطای ارتباط '+x.Status;try{m=JSON.parse(x.ResponseText).error||m}catch(e){}throw new Error(m)}return x.ResponseText?JSON.parse(x.ResponseText):{}}
function rustdesk(){var p=[sh.ExpandEnvironmentStrings('%ProgramFiles%')+'\\RustDesk\\rustdesk.exe',sh.ExpandEnvironmentStrings('%ProgramFiles(x86)%')+'\\RustDesk\\rustdesk.exe',sh.ExpandEnvironmentStrings('%LOCALAPPDATA%')+'\\RustDesk\\rustdesk.exe'];for(var i=0;i<p.length;i++)if(fs.FileExists(p[i]))return p[i];try{var r=sh.Exec('where rustdesk.exe'),a=r.StdOut.ReadAll().replace(/\r/g,'').split('\n');for(var j=0;j<a.length;j++)if(a[j]&&fs.FileExists(a[j]))return a[j]}catch(e){}return ''}
function host(){try{return new ActiveXObject('WScript.Network').ComputerName}catch(e){return 'Windows'}}
function login(){try{root=el('server').value.replace(/\/$/,'');var r=call('POST','/api/client/login',{username:el('user').value,password:el('pass').value});token=r.token;el('login').style.display='none';el('main').style.display='block';msg('status','ورود موفق: '+r.username,true);loadFav()}catch(e){msg('loginMsg',e.message,false)}}
function loadFav(){try{var a=call('GET','/api/favorites').items;el('favorites').innerHTML=a.map(function(x){return '<div class="fav"><span><b>'+esc(x.name||x.target_id)+'</b><br><span class="muted">'+esc(x.target_id)+'</span></span><span><button onclick="useId(\''+esc(x.target_id)+'\')">اتصال</button><button class="del" onclick="removeFav(\''+esc(x.target_id)+'\')">حذف</button></span></div>'}).join('')||'<span class="muted">هنوز دستگاهی ذخیره نشده است.</span>'}catch(e){msg('status',e.message,false)}}
function esc(s){return String(s||'').replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
function useId(id){el('id').value=id;connect()}
function saveFav(){try{var id=el('id').value.trim(),name=el('name').value.trim();if(!id)throw new Error('شناسهٔ مقصد را وارد کن');call('POST','/api/favorites',{target_id:id,name:name});msg('status','دستگاه به فهرست حساب شما افزوده شد.',true);loadFav()}catch(e){msg('status',e.message,false)}}
function removeFav(id){try{call('POST','/api/favorites/delete',{target_id:id});loadFav()}catch(e){msg('status',e.message,false)}}
function doConnect(){try{if(eventId)throw new Error('نشست قبلی را پایان بده');var id=el('id').value.trim(),exe=rustdesk();if(!id)throw new Error('شناسهٔ مقصد را وارد یا از فهرست انتخاب کن');if(!exe)throw new Error('RustDesk نصب‌شده پیدا نشد');call('POST','/api/favorites',{target_id:id,name:el('name').value.trim()||id});loadFav();var r=call('POST','/api/client/events/start',{target_id:id,source_host:host()});eventId=r.event_id;try{sh.Run('"'+exe+'" --connect "'+id+'"',1,false)}catch(e){call('POST','/api/client/events/finish',{event_id:eventId,result:'خطای اجرای RustDesk'});eventId=0;throw e}el('connect').disabled=true;el('finish').disabled=false;msg('status','اتصال آغاز شد و شناسه در فهرست حساب تو ذخیره شد. پس از قطع ریموت دکمهٔ پایان را بزن.',true)}catch(e){msg('status',e.message,false)}}
function finish(){try{call('POST','/api/client/events/finish',{event_id:eventId,result:'پایان توسط کارشناس'});eventId=0;el('connect').disabled=false;el('finish').disabled=true;msg('status','پایان نشست ثبت شد.',true)}catch(e){msg('status',e.message,false)}}
function closeApp(){if(eventId)try{call('POST','/api/client/events/finish',{event_id:eventId,result:'کلاینت بسته شد'})}catch(e){}window.close()}
</script></head><body><div class="top"><h1>کلاینت ریموت - فناوری اطلاعات دانشگاه حضرت معصومه س</h1><span>نسخهٔ ۳ · فهرست مقصدهای شخصی و ثبت نشست</span></div><div class="wrap">
<div id="login" class="box"><h2>ورود</h2><label>نشانی پنل</label><input id="server" value="https://172.16.2.99:8765"><label>نام کاربری پنل</label><input id="user"><label>رمز عبور</label><input id="pass" type="password"><button onclick="login()">ورود</button><div id="loginMsg" class="msg"></div></div>
<div id="main" style="display:none"><div class="box"><h2>اتصال جدید</h2><label>شناسهٔ RustDesk مقصد</label><input id="id"><label>نام دلخواه برای ذخیره در فهرست</label><input id="name" placeholder="مثلاً سیستم آقای احمدی"><button class="alt" onclick="saveFav()">ذخیره در فهرست من</button><button id="connect" onclick="doConnect()">ثبت و اتصال</button><button id="finish" class="alt" disabled onclick="finish()">پایان ثبت نشست</button><div id="status" class="msg"></div></div><div class="box"><h2>دستگاه‌های ذخیره‌شده در حساب من</h2><div id="favorites"></div></div><div class="muted">برای ذخیره شدن نام و IP خودکار مقصد، روی رایانهٔ مقصد باید Device Agent نصب و فعال باشد. خود RustDesk باید از قبل نصب و برای سرور دانشگاه پیکربندی شده باشد.</div></div></div><script>window.resizeTo(540,690);</script></body></html>
